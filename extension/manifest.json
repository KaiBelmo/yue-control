{
  "manifest_version": 3,
  "name": "Spotikey Bridge",
  "version": "1.0.0",
  "description": "Connects open.spotify.com to the Spotikey tray app: queue, shuffle, like and volume over localhost.",
  "permissions": ["alarms"],
  "host_permissions": ["https://open.spotify.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
