{
  "manifest_version": 3,
  "name": "yuecontrol bridge",
  "version": "1.3.0",
  "description": "Connects Spotify, YouTube Music, YouTube and SoundCloud to the yuecontrol tray app: queue, shuffle, like and volume over localhost.",
  "permissions": ["alarms"],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://soundcloud.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["ytmusic.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["soundcloud.js"],
      "run_at": "document_idle"
    }
  ]
}
